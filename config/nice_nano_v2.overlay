#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,display = &oled;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; 
        a-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>; 
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        /* Đã đảo 2 hàng cho hết ngược */
        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 20  GPIO_ACTIVE_HIGH>
            , <&gpio0 24  GPIO_ACTIVE_HIGH>
            , <&gpio1 0   GPIO_ACTIVE_HIGH>
            , <&gpio0 11  GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    sda-pin = <10>; /* P0.10 */
    scl-pin = <43>; /* P1.11 (tính theo công thức base 32 của nRF: 32 + 11 = 43) */

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>; /* Đổi thành 64 nếu màn hình của bác là loại 128x64 */
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>; /* Đổi thành 63 nếu màn hình của bác là loại 128x64 */
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};
